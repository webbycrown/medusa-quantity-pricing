{
  "name": "@webbycrown/medusa-quantity-pricing-rules",
  "version": "1.0.0",
  "description": "Medusa v2 plugin: quantity range pricing engine with admin UI, store API, and PostgreSQL-backed tiers",
  "homepage": "https://github.com/webbycrown/medusa-quantity-pricing",
  "repository": {
    "type": "git",
    "url": "https://github.com/webbycrown/medusa-quantity-pricing.git"
  },
  "author": "webbycrown",
  "license": "MIT",
  "keywords": [
    "medusa",
    "medusa-v2",
    "medusa-plugin",
    "quantity-pricing",
    "tiered-pricing",
    "volume-pricing",
    "b2b-pricing",
    "ecommerce"
  ],
  "files": [
    "dist",
    "!.dist/**/__tests__",
    "!.dist/**/*.d.ts.map",
    "scripts/install-medusa-output.mjs",
    "public",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./workflows": "./dist/src/modules/pricing-engine/workflows/index.js",
    "./.medusa/server/src/modules/*": "./dist/src/modules/*/index.js",
    "./.medusa/server/src/*": "./dist/src/*",
    "./modules/*": "./dist/src/modules/*/index.js",
    "./admin": {
      "import": "./dist/src/admin/index.mjs",
      "require": "./dist/src/admin/index.js",
      "default": "./dist/src/admin/index.js"
    },
    "./lib/*": "./dist/src/lib/*.js",
    "./api/*": "./dist/src/api/*.js",
    "./subscribers/*": "./dist/src/subscribers/*.js"
  },
  "scripts": {
    "build": "medusa plugin:build && node scripts/sync-dist.mjs",
    "dev": "medusa plugin:develop",
    "prepare": "node scripts/prepare.mjs",
    "postinstall": "node scripts/install-medusa-output.mjs",
    "prepack": "medusa plugin:build && node scripts/sync-dist.mjs",
    "prepublishOnly": "medusa plugin:build && node scripts/sync-dist.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dependencies": {
    "zod": "^3.23.0 || ^4.0.0"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "^2.13.0",
    "@medusajs/cli": "^2.13.0",
    "@medusajs/framework": "^2.13.0",
    "@medusajs/icons": "^2.13.0",
    "@medusajs/js-sdk": "^2.13.0",
    "@medusajs/medusa": "^2.13.0",
    "@medusajs/ui": "^4.0.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "react-router-dom": "^6.0.0"
  },
  "peerDependenciesMeta": {
    "@medusajs/admin-sdk": {
      "optional": true
    },
    "@medusajs/icons": {
      "optional": true
    },
    "@medusajs/js-sdk": {
      "optional": true
    },
    "@medusajs/ui": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "react-router-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.15.3",
    "@medusajs/cli": "2.15.3",
    "@medusajs/framework": "2.15.3",
    "@medusajs/icons": "2.15.3",
    "@medusajs/js-sdk": "2.15.3",
    "@medusajs/medusa": "2.15.3",
    "@medusajs/ui": "4.1.13",
    "@tanstack/react-query": "5.64.2",
    "@types/react": "^18.3.2",
    "@types/react-dom": "^18.2.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "6.30.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
